{
  "name": "canon-character-card",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "author": "huanglinfei091-cmd",
  "description": "不使用生成式模型的角色资料采集与角色卡整理工具",
  "scripts": {
    "start": "node server.js",
    "test": "node --test",
    "desktop": "electron .",
    "desktop:make": "electron-forge make --platform=win32 --arch=x64",
    "native:build": "vite build --config vite.native.config.js",
    "android:sync": "npm run native:build && cap sync android",
    "android:apk": "npm run android:sync && cd android && gradlew.bat assembleDebug"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@capacitor/core": "^8.5.1",
    "@capacitor/filesystem": "^8.1.0",
    "@capacitor/share": "^8.0.1",
    "cheerio": "^1.1.2",
    "docx": "^9.5.1",
    "express": "^5.1.0"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.1",
    "@capacitor/cli": "^8.5.1",
    "@electron-forge/cli": "^7.10.2",
    "@electron-forge/maker-zip": "^7.10.2",
    "electron": "^44.3.0",
    "vite": "^7.1.5"
  }
}
